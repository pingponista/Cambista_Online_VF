          "range": true,
          "refId": "A"
        }
      ],
      "title": "Throughput (RPS - Requests por Segundo por Microservicio)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] },
