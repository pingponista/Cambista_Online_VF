          "datasource": { "type": "tempo", "uid": "tempo" },
          "query": "${traceId}",
          "queryType": "traceId",
          "refId": "A"
        }
      ],
      "title": "Visor de Traza Individual (Waterfall)",
      "type": "traces"
    }
